# ==========================================
# StockWise - Root .gitignore
# ==========================================

# ---------- Secrets and environment ----------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets/
credentials/
service-account*.json
backend/.env
frontend/.env

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
.python-version.local

# ---------- Python tooling and test artifacts ----------
.pytest_cache/
.mypy_cache/
.pytype/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
test-results/
junit.xml

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Logs and temporary files ----------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Frontend / Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.parcel-cache/
.vite/
.turbo/
*.tsbuildinfo
.env

# ---------- Frontend build output ----------
# Keep the standard React/Vite source and configuration files.
frontend/dist/
frontend/build/
frontend/coverage/

# ---------- Build and generated artifacts ----------
artifacts/
generated/
*.generated.*

# ---------- Databases and local database files ----------
*.sqlite
*.sqlite3
*.db
*.dump
*.bak.sql

# ---------- Uploads and sensitive business documents ----------
uploads/*
!uploads/.gitkeep
data/uploads/
private_uploads/
invoices/
*.invoice
*.p12
*.pfx

# ---------- AI / RAG local artifacts ----------
# Do not ignore source code, prompts, evaluation datasets,
# or documented test fixtures.
chroma_db/
chroma.sqlite3
faiss.index
faiss.index.*
vector_store/
embeddings_cache/
model_cache/
.cache/
.huggingface/

# ---------- Local AI / evaluation outputs ----------
evaluation-results/
eval-results/
traces/
*.trace
*.har

# ---------- Docker local overrides ----------
docker-compose.override.yml
compose.override.yaml

# ---------- IDEs ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.code-workspace

# ---------- OS ----------
.Trashes
.Spotlight-V100
.fseventsd/

# ---------- Keep project configuration templates ----------
!.env.example
!backend/.env.example
!frontend/.env.example