# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=StockWise API
APP_VERSION=0.1.0
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# For Docker Compose: use @db:5432
# For local development: use @localhost:5432
DATABASE_URL=postgresql+psycopg://stockwise_user:stockwise_pass@db:5432/stockwise

# ── AI Provider ───────────────────────────────────────────────────────────────
# "mock"   → no API calls, deterministic test output (default, safe for CI)
# "gemini" → real Google Gemini API calls (requires GEMINI_API_KEY below)
AI_PROVIDER=mock

# Google Gemini API key — get one at https://aistudio.google.com/
# Leave blank (or omit) when AI_PROVIDER=mock.
# NEVER commit a real key to Git.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for assistant chat and invoice extraction.
# Default "gemini-3.5-flash-lite" is ultra-fast, capable, and low-latency.
GEMINI_MODEL=gemini-3.5-flash-lite

# Embedding model and vector dimensions.
# Must match the model used when documents were ingested.
# Changing this after ingestion requires re-indexing all documents.
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768

# API call behaviour
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_MAX_TOOL_ROUNDS=3

# ── Invoice Extraction Provider ───────────────────────────────────────────────
# "mock"   → hardcoded demo data (safe for tests, no API cost)
# "gemini" → real document extraction via Gemini (requires GEMINI_API_KEY)
INVOICE_EXTRACTION_PROVIDER=mock

# ── RAG / Retrieval ───────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_MIN_SCORE=0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production: set to your exact frontend origin, e.g. https://yourdomain.com
CORS_ALLOWED_ORIGINS=*
